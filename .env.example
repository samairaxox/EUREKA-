# Copy to .env (never commit .env). Every value below is a placeholder.

# ── AI provider (existing) ──────────────────────────
GROQ_API_KEY=replace-with-your-groq-key
GROQ_REASONING_EFFORT=low

# ── Database ────────────────────────────────────────
# Local development with docker-compose.yml:
EUREKA_ENV=development
DATABASE_URL=postgresql+psycopg://eureka:eureka_dev_password@localhost:5432/eureka_dev
AUTO_MIGRATE=false

# ── Sessions ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Keep this server-side only.
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Set to true in any HTTPS deployment so the refresh cookie is only sent over TLS.
COOKIE_SECURE=false

# ── CORS: the exact origin(s) of the frontend, comma-separated. Never use * in production.
CORS_ORIGINS=http://localhost:3000

# ── Rate limits (requests per minute per client IP) ─
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=30

# ── PDF / RAG processing ───────────────────────────
# Character approximation is deliberately conservative (3 chars ≈ 1 token).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_OUTPUT_TOKENS=700
GROQ_TIMEOUT_SECONDS=60
GROQ_RETRY_COUNT=2
GROQ_MAX_RETRY_WAIT_SECONDS=120
GROQ_MAX_CONCURRENT_REQUESTS=1
RAG_CONTEXT_TOKEN_BUDGET=2400
RAG_PROMPT_TOKEN_RESERVE=700
RAG_MAX_RETRIEVED_CHUNKS=8
RAG_CHUNK_SIZE_TOKENS=850
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_CHARS_PER_TOKEN=3
RAG_MAX_DOCUMENT_CHUNKS=160
RAG_PLAN_MAX_DAYS=120
MAX_PDF_BYTES=31457280
PDF_MIN_EXTRACTABLE_CHARS=40
SUMMARY_CHUNK_SIZE_TOKENS=800
SUMMARY_CHUNK_OVERLAP_TOKENS=80
SUMMARY_MAX_CHUNKS=160
SUMMARY_REDUCE_CONTEXT_TOKENS=2200
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RAG_MAX_CONCURRENT_EMBEDDINGS=1
RAG_SESSION_TTL_SECONDS=3600
RAG_MAX_SESSIONS=8

# ── Google sign-in (optional) ───────────────────────
# Backend: the OAuth Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# Frontend (study-frontend/.env.local): the same client ID. It is public and safe in the browser.
# REACT_APP_GOOGLE_CLIENT_ID=
# Frontend: the API base URL the browser should call.
# REACT_APP_API_URL=http://localhost:8000
