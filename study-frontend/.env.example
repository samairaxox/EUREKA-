# Copy to study-frontend/.env.local. Only REACT_APP_* values are visible in the browser; never put secrets here.

# Base URL of the EUREKA API.
REACT_APP_API_URL=http://localhost:8000
REACT_APP_LONG_AI_TIMEOUT_MS=300000

# Google OAuth Web client ID (public). Leave empty to hide Google sign-in until it is configured.
REACT_APP_GOOGLE_CLIENT_ID=
